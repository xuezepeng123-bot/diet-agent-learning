<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.diet.learning.MealMapper">
    <select id="search" resultType="com.diet.learning.Meal">
        SELECT id, name, meal_time AS mealTime, taste
        FROM meal_item
        <where>
            <if test="mealTime != null">
                AND meal_time = #{mealTime}
            </if>
            <if test="taste != null">
                AND taste = #{taste}
            </if>
        </where>
        ORDER BY id
    </select>
</mapper>